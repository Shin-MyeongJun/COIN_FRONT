# ====================================================================
# coin_front — Production environment (Vite build mode: `production`)
#
# Loaded automatically by `vite build` / `npm run build`.
# Override per-deploy with shell `VITE_*` env vars passed to the build
# command in CI (those win over this file).
#
# WARNING: every VITE_* value is **bundled into the public JS** — do NOT
# put server secrets or third-party API keys here.
# ====================================================================

# --- Required ---
# Replace with the actual prod API origin (no trailing slash, HTTPS only —
# CloudFront serves the SPA over HTTPS, so an HTTP API would trigger
# mixed-content blocks in the browser).
VITE_API_BASE_URL=https://api.coindata.example.com

# --- Mock toggles ---
# Backend feature endpoints must be hit live in production.
VITE_USE_MOCK=false

# External widgets (Nasdaq / metals / Fear&Greed / 10Y / FX) stay mocked.
# Reason: those vendors require API keys that would leak via VITE_*, and
# direct browser calls fail CORS. See features/globalBar/api/externalMock.ts.
VITE_USE_MOCK_EXTERNAL=true

# --- Optional ---
# Keep this assignment present (even with an empty value) so that any
# developer-side `.env.local` (which Vite loads with HIGHER priority than
# `.env.production`) cannot leak its dev `localhost:8080` SSE host into a
# prod build run locally. `env.ts` treats empty as "fall back to apiBaseUrl".
# Override with a real value here when SSE moves to a separate origin.
VITE_SSE_BASE_URL=

# Leave these BLANK in production — keys here would be served to every
# browser. Real external integrations go through the backend proxy.
VITE_FINNHUB_API_KEY=
VITE_GOLDAPI_KEY=

# UI presets.
VITE_DEFAULT_THEME=dark
VITE_APP_NAME=CoinData
