# ====================================================================
# coin_front — Environment Variables
# Copy this file to `.env.local` for local development.
# `.env.local` must NEVER be committed (it is .gitignore'd).
# ====================================================================

# --- Required ---
# Backend API base URL (no trailing slash).
VITE_API_BASE_URL=http://localhost:8080

# --- Mock toggles ---
# When true, all backend calls use in-memory mocks instead of HTTP.
# Defaults to true if unset so first-run developers see the UI immediately.
VITE_USE_MOCK=true

# Mock external (Finnhub / GoldAPI / etc.) data sources.
VITE_USE_MOCK_EXTERNAL=true

# --- Optional ---
# SSE base URL (defaults to VITE_API_BASE_URL when omitted).
VITE_SSE_BASE_URL=http://localhost:8080

# External provider keys (kept ONLY in .env.local — never commit secrets).
VITE_FINNHUB_API_KEY=
VITE_GOLDAPI_KEY=

# UI presets.
VITE_DEFAULT_THEME=dark
VITE_APP_NAME=CoinData
